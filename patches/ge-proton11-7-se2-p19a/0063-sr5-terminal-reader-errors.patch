+/* Called under reader->cs. A fatal source failure is not EOF and cannot be
+ * recovered by another read/seek on this reader. Complete outstanding demand;
+ * commands not yet processed observe terminal_error when they start. */
+static void source_reader_set_terminal_error(struct source_reader *reader, HRESULT status)
+{
+    unsigned int i;
+
+    if (SUCCEEDED(status) || FAILED(reader->terminal_error))
+        return;
+    reader->terminal_error = status;
+    reader->flags &= ~(SOURCE_READER_SEEKING | SOURCE_READER_ASYNC_SEEK_QUEUED);
+    for (i = 0; i < reader->stream_count; ++i)
+    {
+        reader->streams[i].flags &= ~STREAM_FLAG_SAMPLE_REQUESTED;
+        source_reader_fail_stream_drain(reader, &reader->streams[i], status);
+    }
+    WakeAllConditionVariable(&reader->state_event);
+    WakeAllConditionVariable(&reader->sample_event);
+}
