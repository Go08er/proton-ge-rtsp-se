From: RTSP-on-GE contributors
Subject: [PATCH] winedmo: Expose existing MPEG-1/2 video decoder admission

Admit canonical MPEG1Payload, public MF MPG1 and MPEG2 in the existing
WMV-backed MFT/DMO. Demux, Unix reverse mappings and parser already exist.
Forward the native MPEG_SEQUENCE_HEADER attribute for these exact subtypes,
falling back to generic USER_DATA when absent. Bound the combined allocation.
No codec-tag rewriting, new parser, output, decode, queue or clock change.
Source integration only; actual MF frame/seek qualification is required.

diff --git a/dlls/winedmo/video_decoder.c b/dlls/winedmo/video_decoder.c
index f5213ec..9af17bd 100644
--- a/dlls/winedmo/video_decoder.c
+++ b/dlls/winedmo/video_decoder.c
@@ -532,11 +532,24 @@ static HRESULT fill_mfvideoformat(IMFMediaType *type, MFVIDEOFORMAT *fmt)
 static HRESULT create_mfvideoformat(IMFMediaType *type, union winedmo_format **format, UINT32 *format_size)
 {
     UINT32 user_data_size = 0, size = sizeof(MFVIDEOFORMAT);
+    const GUID *data_key = &MF_MT_USER_DATA;
     union winedmo_format *fmt;
+    GUID subtype;
     HRESULT hr;
 
-    if (SUCCEEDED(IMFMediaType_GetBlobSize(type, &MF_MT_USER_DATA, &user_data_size)))
-        size += user_data_size;
+    /* Native MPEG media types use MPEG_SEQUENCE_HEADER; the demuxer's generic
+     * MFVIDEOFORMAT representation uses USER_DATA. Preserve either contract. */
+    if (SUCCEEDED(IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &subtype))
+            && (IsEqualGUID(&subtype, &MEDIASUBTYPE_MPEG1Payload)
+                || IsEqualGUID(&subtype, &MFVideoFormat_MPG1)
+                || IsEqualGUID(&subtype, &MFVideoFormat_MPEG2))
+            && SUCCEEDED(IMFMediaType_GetBlobSize(type, &MF_MT_MPEG_SEQUENCE_HEADER, &user_data_size)))
+        data_key = &MF_MT_MPEG_SEQUENCE_HEADER;
+    else if (FAILED(IMFMediaType_GetBlobSize(type, data_key, &user_data_size)))
+        user_data_size = 0;
+    if (user_data_size > UINT32_MAX - size)
+        return E_INVALIDARG;
+    size += user_data_size;
 
     if (!(fmt = calloc(1, size)))
         return E_OUTOFMEMORY;
@@ -546,7 +559,7 @@ static HRESULT create_mfvideoformat(IMFMediaType *type, union winedmo_format **f
     {
         fmt->video.dwSize = size;
         if (user_data_size)
-            hr = IMFMediaType_GetBlob(type, &MF_MT_USER_DATA, (BYTE *)(fmt + 1), user_data_size, NULL);
+            hr = IMFMediaType_GetBlob(type, data_key, (BYTE *)(fmt + 1), user_data_size, NULL);
     }
 
     if (FAILED(hr))
@@ -2536,6 +2549,9 @@ static const GUID *const wmv_decoder_input_types[] =
     &MFVideoFormat_VP80,
     &MFVideoFormat_HEVC,
     &MFVideoFormat_MJPG,
+    &MEDIASUBTYPE_MPEG1Payload,
+    &MFVideoFormat_MPG1,
+    &MFVideoFormat_MPEG2,
 };
 static const GUID *const wmv_decoder_output_types[] =
 {
diff --git a/dlls/wmvdecod/wmvdecod.c b/dlls/wmvdecod/wmvdecod.c
index fe11e1f..8f7c392 100644
--- a/dlls/wmvdecod/wmvdecod.c
+++ b/dlls/wmvdecod/wmvdecod.c
@@ -72,6 +72,9 @@ HRESULT WINAPI DllRegisterServer(void)
         {MFMediaType_Video, MFVideoFormat_VP80},
         {MFMediaType_Video, MFVideoFormat_HEVC},
         {MFMediaType_Video, MFVideoFormat_MJPG},
+        {MFMediaType_Video, MEDIASUBTYPE_MPEG1Payload},
+        {MFMediaType_Video, MFVideoFormat_MPG1},
+        {MFMediaType_Video, MFVideoFormat_MPEG2},
     };
     MFT_REGISTER_TYPE_INFO wmv_decoder_mft_outputs[] =
     {
@@ -117,6 +120,9 @@ HRESULT WINAPI DllRegisterServer(void)
         {.type = MEDIATYPE_Video, .subtype = MFVideoFormat_VP80},
         {.type = MEDIATYPE_Video, .subtype = MFVideoFormat_HEVC},
         {.type = MEDIATYPE_Video, .subtype = MFVideoFormat_MJPG},
+        {.type = MEDIATYPE_Video, .subtype = MEDIASUBTYPE_MPEG1Payload},
+        {.type = MEDIATYPE_Video, .subtype = MFVideoFormat_MPG1},
+        {.type = MEDIATYPE_Video, .subtype = MFVideoFormat_MPEG2},
     };
     HRESULT hr;
 

