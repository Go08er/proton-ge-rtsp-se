+/* Private WineDMO / SourceReader presentation-coordinate contract. */
+#ifndef __WINE_MFORIGIN_H
+#define __WINE_MFORIGIN_H
+
+#include <stdint.h>
+#include "windef.h"
+#include "guiddef.h"
+
+/* Versioned by this GUID and the exact blob size, never a public MF attribute. */
+DEFINE_GUID(MF_WINE_PD_PRESENTATION_ORIGIN, 0xf5604b90, 0xe493, 0x48ba,
+        0x94, 0x9c, 0x72, 0x3f, 0xb1, 0x3a, 0x5e, 0x2d);
+
+enum wine_mf_origin_coordinates
+{
+    WINE_MF_ORIGIN_UNKNOWN,
+    WINE_MF_ORIGIN_NATIVE,
+    WINE_MF_ORIGIN_NORMALIZED,
+};
+
+struct wine_mf_presentation_origin
+{
+    INT64 origin; /* signed 100ns source origin; zero is a valid origin */
+    UINT32 valid;
+    UINT32 coordinates; /* whether source samples / seeks already subtract origin */
+};
+
+C_ASSERT(sizeof(struct wine_mf_presentation_origin) == 16);
+
+#endif
