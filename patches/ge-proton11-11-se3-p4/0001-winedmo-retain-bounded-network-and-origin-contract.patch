+static enum direct_network_url get_rtsp_url_kind( const char *url )
+{
+    if (!url) return DIRECT_NETWORK_NONE;
+    if (!strncasecmp( url, "rtsp://", 7 )) return DIRECT_NETWORK_RTSP;
+    if (!strncasecmp( url, "rtspt://", 8 )) return DIRECT_NETWORK_RTSP_TCP;
+    if (!strncasecmp( url, "rtspu://", 8 )) return DIRECT_NETWORK_RTSP_UDP;
+    if (!strncasecmp( url, "rtsps://", 8 )) return DIRECT_NETWORK_RTSPS_TCP;
+    if (!strncasecmp( url, "rtspst://", 9 )) return DIRECT_NETWORK_RTSPS_TCP;
+    return DIRECT_NETWORK_NONE;
+}
+
+static char *normalize_rtsp_url( const char *url, enum direct_network_url kind )
+{
+    const char *suffix, *scheme = "rtsp";
+    char *ret;
+    size_t len, scheme_len;
+
+    switch (kind)
+    {
+    case DIRECT_NETWORK_RTSP:
+        suffix = url + 4; /* Preserve everything beginning with the colon. */
+        break;
+    case DIRECT_NETWORK_RTSP_TCP:
+    case DIRECT_NETWORK_RTSP_UDP:
+        suffix = url + 5;
+        break;
+    case DIRECT_NETWORK_RTSPS_TCP:
+        scheme = "rtsps";
+        suffix = url + (!strncasecmp( url, "rtspst://", 9 ) ? 6 : 5);
+        break;
+    default:
+        return NULL;
+    }
+
+    scheme_len = strlen( scheme );
+    len = scheme_len + strlen( suffix ) + 1;
+    if (!(ret = malloc( len ))) return NULL;
+    memcpy( ret, scheme, scheme_len );
+    memcpy( ret + scheme_len, suffix, len - scheme_len );
+    return ret;
 }
 
