+static struct media_stream *media_source_find_stream(struct media_source *source,
+        UINT demux_index, UINT *source_index)
+{
+    UINT i;
+
+    for (i = 0; i < source->stream_count; i++)
+    {
+        if (source->streams[i]->stream_index != demux_index)
+            continue;
+        if (source_index)
+            *source_index = i;
+        return source->streams[i];
+    }
+    return NULL;
