+static LONG media_source_begin_demux_transition(struct media_source *source)
+{
+    LONG epoch = InterlockedCompareExchange(&source->demux_transition_epoch, 0, 0);
+
+    if (!(epoch & 1))
+        epoch = InterlockedIncrement(&source->demux_transition_epoch);
+    return epoch;
+}
+
+static void media_source_end_demux_transition(struct media_source *source)
+{
+    LONG epoch = InterlockedIncrement(&source->demux_transition_epoch);
+
+    assert(!(epoch & 1));
+}
+
+static LONG media_source_get_demux_transition(struct media_source *source)
+{
+    return InterlockedCompareExchange(&source->demux_transition_epoch, 0, 0);
+}
+
+static HRESULT media_source_error_from_demux_status(NTSTATUS status)
+{
+    if (status == STATUS_CANCELLED)
+        return MF_E_OPERATION_CANCELLED;
+    if (status == STATUS_IO_TIMEOUT)
+        return MF_E_NET_TIMEOUT;
+    if (status == STATUS_CONNECTION_DISCONNECTED)
+        return MF_E_NET_READ;
+    if (status == STATUS_DATA_ERROR)
+        return MF_E_INVALID_STREAM_DATA;
+    if (status == STATUS_NO_MEMORY)
+        return E_OUTOFMEMORY;
+    return HRESULT_FROM_NT(status);
+}
