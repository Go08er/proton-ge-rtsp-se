+static void source_buffering(struct media_source *source, BOOL active)
+{
+    unsigned int i;
+    HRESULT hr;
+    if (source->buffering != active)
+    {
+        hr = IMFMediaEventQueue_QueueEventParamVar(source->event_queue,
+                active ? MEBufferingStarted : MEBufferingStopped, &GUID_NULL, S_OK, NULL);
+        if (active && FAILED(hr)) return;
+        InterlockedExchange(&source->buffering, active);
+        if (source->live_enabled && source->rate == 1.0f)
+        {
+            source->live_hold = active ? GetTickCount64() : 0;
+            source->live_quiet = active ? 0 : GetTickCount64();
+        }
+    }
+    for (i = 0; i < source->stream_count; ++i)
+    {
+        EnterCriticalSection(&source->streams[i]->queue_cs);
+        WakeAllConditionVariable(&source->streams[i]->queue_cv);
+        LeaveCriticalSection(&source->streams[i]->queue_cs);
+    }
+}
+
+static void reset_buffering(struct media_source *source)
+{
+    unsigned int i;
+    source_buffering(source, FALSE);
+    ++source->buffering_generation;
+    source->buffering_poll = 0;
+    source->buffering_last_time = INT64_MIN;
+    for (i = 0; i < source->stream_count; ++i)
+    {
+        source->streams[i]->delivered_known = FALSE;
+        source->streams[i]->starved_ms = 0;
+    }
+}
+
+/* Only naturally completed holds measure jitter, not Pause, Stop or seek. */
+static void live_hold_complete(struct media_source *source, ULONGLONG now)
+{
+    UINT expired = 0;
+    if (!source->live_enabled || source->rate != 1.0f || !source->live_hold || now - source->live_hold < 500) return;
+    while (expired < source->live_stutters && now - source->live_holds[expired] >= 120000) ++expired;
+    source->live_stutters -= expired;
+    memmove(source->live_holds, source->live_holds + expired, source->live_stutters * sizeof(*source->live_holds));
+    if (source->live_level + 1 == ARRAY_SIZE(live_targets)) return;
+    if (source->live_stutters < ARRAY_SIZE(source->live_holds)) source->live_holds[source->live_stutters++] = now;
+    if (source->live_stutters >= source->live_level + 2)
+    {
+        ++source->live_level;
+        source->live_stutters = 0;
+    }
+}
+
+/* Queue lock held. Packet PTS span avoids counting multi-frame AAC packets as
+ * one AAC frame. Unknown timestamps cannot establish a refill reserve. */
+static LONGLONG live_queue_span(struct media_stream *stream)
+{
+    struct media_packet *pkt;
+    LONGLONG first = INT64_MAX, last = INT64_MIN;
+    LIST_FOR_EACH_ENTRY(pkt, &stream->packet_queue, struct media_packet, entry)
+    {
+        if (pkt->pts == INT64_MIN) return 0;
+        first = min(first, pkt->pts); last = max(last, pkt->pts);
+    }
+    return last <= first || (first < 0 && last > INT64_MAX + first) ? 0 : last - first;
+}
+
+/* The timer retains the source. Clock calls occur outside all source/queue locks;
+ * the generation and clock identity retire a poll crossing seek or replacement. */
+static void CALLBACK buffering_poll(IUnknown *context)
+{
+    struct media_source *source = impl_from_IMFMediaSource((IMFMediaSource *)context);
+    IMFPresentationClock *clock;
+    MFCLOCK_STATE state;
+    ULONGLONG now = GetTickCount64(), elapsed;
+    ULONG generation, i;
+    UINT64 packets = 0, bytes = 0;
+    LONGLONG time;
+    BOOL ready = TRUE, eligible = TRUE, exhausted = FALSE;
+    HRESULT hr;
+
+    if (InterlockedCompareExchange(&source->buffering_poll_busy, 1, 0)) return;
+    EnterCriticalSection(&source->cs);
+    if (source->state != SOURCE_RUNNING || source->demux_thread_shutdown || source->read_flushing || !(clock = source->clock)
+            || now - source->buffering_poll < 50)
+    { LeaveCriticalSection(&source->cs); InterlockedExchange(&source->buffering_poll_busy, 0); return; }
+    elapsed = source->buffering_poll ? now - source->buffering_poll : 0;
+    source->buffering_poll = now;
+    generation = source->buffering_generation;
+    IMFPresentationClock_AddRef(clock);
+    LeaveCriticalSection(&source->cs);
+    hr = IMFPresentationClock_GetState(clock, 0, &state);
+    if (SUCCEEDED(hr)) hr = IMFPresentationClock_GetTime(clock, &time);
+    EnterCriticalSection(&source->cs);
+    if (source->state != SOURCE_RUNNING || source->demux_thread_shutdown || source->read_flushing
+            || generation != source->buffering_generation || clock != source->clock)
+        goto done;
+    if (source->live_enabled && source->rate == 1.0f && !source->buffering && source->live_quiet && now - source->live_quiet >= LIVE_QUIET_MS)
+    {
+        if (source->live_level) --source->live_level;
+        source->live_quiet = now;
+    }
+    for (i = 0; i < source->stream_count; ++i)
+    {
+        struct media_stream *stream = source->streams[i];
+        BOOL eos;
+        if (!stream->active) continue;
+        EnterCriticalSection(&stream->queue_cs);
+        packets += stream->queued_packets; bytes += stream->queued_bytes;
+        eos = stream->eos;
+        if (!eos && (source->live_enabled && source->rate == 1.0f ? live_queue_span(stream) < live_targets[source->live_level] :
+                stream->queued_unknown || stream->queued_duration < BUFFERING_RESERVE)) ready = FALSE;
+        LeaveCriticalSection(&stream->queue_cs);
+        if (eos) continue;
+        if (FAILED(hr) || state != MFCLOCK_STATE_RUNNING || !stream->delivered_known
+                || time < stream->delivered_start)
+        { stream->starved_ms = 0; eligible = FALSE; continue; }
+        if (!(stream->sample_worker_pending || stream->token_queue_count)) { stream->starved_ms = 0; continue; }
+        if (!stream->starved_ms || now - stream->starvation_window >= 5000 || elapsed > 100
+                || time < source->buffering_last_time || (time < stream->delivered_end
+                && (UINT64)stream->delivered_end - (UINT64)time > 1000000))
+        { stream->starved_ms = 0; stream->starvation_window = now; }
+        if (time >= stream->delivered_end && elapsed <= 100) stream->starved_ms += elapsed;
+        if (stream->starved_ms >= 100) exhausted = TRUE;
+    }
+    if (source->buffering)
+    {
+        if (ready || packets >= MEDIA_SOURCE_EMERGENCY_QUEUED_PACKETS || bytes >= MEDIA_SOURCE_EMERGENCY_QUEUED_BYTES)
+        {
+            live_hold_complete(source, now);
+            source_buffering(source, FALSE);
+        }
+    }
+    else if (eligible && exhausted) source_buffering(source, TRUE);
+    if (SUCCEEDED(hr)) source->buffering_last_time = time;
+done:
+    LeaveCriticalSection(&source->cs);
+    IMFPresentationClock_Release(clock);
+    InterlockedExchange(&source->buffering_poll_busy, 0);
+}
