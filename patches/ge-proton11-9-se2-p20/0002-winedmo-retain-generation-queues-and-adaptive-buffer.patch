+static struct media_source *source_from_clock(IMFClockConsumer *iface)
+{
+    return CONTAINING_RECORD(iface, struct media_source, IMFClockConsumer_iface);
+}
+static HRESULT WINAPI source_clock_query(IMFClockConsumer *iface, REFIID iid, void **out)
+{
+    return IMFMediaSource_QueryInterface(&source_from_clock(iface)->IMFMediaSource_iface, iid, out);
+}
+static ULONG WINAPI source_clock_addref(IMFClockConsumer *iface)
+{
+    return IMFMediaSource_AddRef(&source_from_clock(iface)->IMFMediaSource_iface);
+}
+static ULONG WINAPI source_clock_release(IMFClockConsumer *iface)
+{
+    return IMFMediaSource_Release(&source_from_clock(iface)->IMFMediaSource_iface);
+}
+static HRESULT WINAPI source_clock_set(IMFClockConsumer *iface, IMFPresentationClock *clock)
+{
+    struct media_source *source = source_from_clock(iface);
+    IMFPresentationClock *old = NULL;
+    DWORD remove = 0, key = 0;
+    HRESULT hr = S_OK;
+    EnterCriticalSection(&source->cs);
+    if (source->state == SOURCE_SHUTDOWN) hr = MF_E_SHUTDOWN;
+    else
+    {
+        if (clock && source->buffering_network && !source->periodic_key)
+        {
+            hr = MFAddPeriodicCallback(buffering_poll, (IUnknown *)&source->IMFMediaSource_iface, &key);
+            if (SUCCEEDED(hr)) source->periodic_key = key;
+        }
+        if (SUCCEEDED(hr))
+        {
+            reset_buffering(source);
+            if (clock) IMFPresentationClock_AddRef(clock);
+            old = source->clock; source->clock = clock;
+            if (!clock) { remove = source->periodic_key; source->periodic_key = 0; }
+        }
+    }
+    LeaveCriticalSection(&source->cs);
+    if (remove) MFRemovePeriodicCallback(remove); /* Drains synchronously: never hold source->cs. */
+    if (old) IMFPresentationClock_Release(old);
+    return hr;
+}
+static HRESULT WINAPI source_clock_get(IMFClockConsumer *iface, IMFPresentationClock **clock)
+{
+    struct media_source *source = source_from_clock(iface);
+    HRESULT hr;
+    if (!clock) return E_POINTER;
+    EnterCriticalSection(&source->cs);
+    *clock = source->clock;
+    hr = source->state == SOURCE_SHUTDOWN ? MF_E_SHUTDOWN : *clock ? S_OK : MF_E_NO_CLOCK;
+    if (*clock) IMFPresentationClock_AddRef(*clock);
+    LeaveCriticalSection(&source->cs);
+    return hr;
+}
