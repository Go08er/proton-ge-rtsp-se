+/* Demuxer lock held. Queue an error marker behind the read-ahead data of every
+ * active stream and idle the demux thread like at EOF, without signalling EOS. */
+static BOOL media_source_defer_demux_error(struct media_source *source, LONG epoch, HRESULT error)
+{
+    BOOL deferred = FALSE;
+    UINT i;
+
+    for (i = 0; i < source->stream_count; ++i)
+    {
+        struct media_stream *stream = source->streams[i];
+        struct media_packet *pkt;
+
+        EnterCriticalSection(&stream->queue_cs);
+        if (stream->active && epoch == media_source_get_demux_transition(source)
+                && (pkt = calloc(1, sizeof(*pkt))))
+        {
+            pkt->epoch = epoch;
+            pkt->error = error;
+            pkt->dts = pkt->pts = pkt->duration = INT64_MIN;
+            list_add_tail(&stream->packet_queue, &pkt->entry);
+            WakeAllConditionVariable(&stream->queue_cv);
+            deferred = TRUE;
+        }
+        LeaveCriticalSection(&stream->queue_cs);
+    }
+    if (deferred)
+    {
+        source->demux_eof = TRUE;
+        if (epoch != media_source_get_demux_transition(source))
+            source->demux_eof = FALSE;
+    }
+    return deferred;
+}
+
