+/* Queue lock held. A deferred error marker is always the last queued entry. */
+static BOOL media_packet_queue_has_error(struct media_stream *stream)
+{
+    struct list *tail = list_tail(&stream->packet_queue);
+    return tail && FAILED(LIST_ENTRY(tail, struct media_packet, entry)->error);
+}
