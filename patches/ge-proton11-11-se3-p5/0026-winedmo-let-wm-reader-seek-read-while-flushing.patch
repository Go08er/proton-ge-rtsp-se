Subject: [SE3-P2] winedmo: let the WM reader's own seek read while flushing

reinit_stream() seeks the demuxer while read_flushing is set, and the read
callback returns EOF for every read during a flush, including the seek's own
index/header reads. Non-zero IWMSyncReader::SetRange() targets (and WM ASF
Reader / AMStream seeks) therefore restart from the beginning; a seek to 0
works by accident. Allow the seeking thread's reads, and have the demux
thread re-check read_flushing under demuxer_cs before reading, so a read
that raced the flush cannot publish a fake EOF after the seek.

---
diff --git a/dlls/winedmo/wm_reader.c b/dlls/winedmo/wm_reader.c
--- a/dlls/winedmo/wm_reader.c
+++ b/dlls/winedmo/wm_reader.c
@@ -107,6 +107,7 @@
     HANDLE demux_thread;
     bool demux_shutdown;
     bool read_flushing;
+    bool seeking;             /* reinit_stream is seeking the demuxer, demuxer_cs held */
     unsigned int read_flush_generation;
     bool flushing;
     CRITICAL_SECTION demuxer_cs;  /* serialises winedmo_demuxer_read vs winedmo_demuxer_seek */
@@ -956,7 +957,8 @@
     ULONG ret_size = 0;
     HRESULT hr;
 
-    if (reader->read_flushing || reader->demux_shutdown)
+    /* The seek in reinit_stream reads through this callback while flushing. */
+    if ((reader->read_flushing && !reader->seeking) || reader->demux_shutdown)
     {
         *size = 0;
         return STATUS_SUCCESS;
@@ -1083,6 +1085,14 @@
         needed_size = buffer_size;
 
         EnterCriticalSection(&reader->demuxer_cs);
+        /* A read between the seek and the end of reinit_stream would see a
+         * flushing EOF and leave the demuxer at EOF. */
+        if (reader->read_flushing)
+        {
+            LeaveCriticalSection(&reader->demuxer_cs);
+            IMediaBuffer_Release(&sbuf->IMediaBuffer_iface);
+            continue;
+        }
         status = winedmo_demuxer_read(reader->demuxer, &stream_idx, &output, &needed_size);
         LeaveCriticalSection(&reader->demuxer_cs);
 
@@ -2391,7 +2401,10 @@
     /* Seek demuxer back to start_time.  Hold demuxer_cs so the demux thread
      * cannot race us with a concurrent winedmo_demuxer_read call. */
     EnterCriticalSection(&reader->demuxer_cs);
-    winedmo_demuxer_seek(reader->demuxer, reader->start_time);
+    reader->seeking = true;
+    if (winedmo_demuxer_seek(reader->demuxer, reader->start_time))
+        ERR("Failed to seek WM reader %p to %s.\n", reader, debugstr_time(reader->start_time));
+    reader->seeking = false;
     LeaveCriticalSection(&reader->demuxer_cs);
 
     /* Recreate decoders and reset EOS flags */
