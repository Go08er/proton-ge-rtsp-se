+
+/* Shutdown does not wait for the audio driver: the audio client is stopped and released by a worker thread, which
+ * takes over the event the client signals. The worker does not use the renderer, which may be released by then. */
+static void audio_renderer_destroy_audio_objects_async(struct audio_renderer *renderer, struct audio_objects *objects,
+        HANDLE event)
+{
+    struct audio_objects_work *work;
+
+    if (objects->client && event && (work = malloc(sizeof(*work))))
+    {
+        work->objects = *objects;
+        work->event = event;
+        if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, (const WCHAR *)audio_renderer_destroy_audio_objects_callback,
+                &work->module))
+            work->module = NULL;
+        if (TrySubmitThreadpoolCallback(audio_renderer_destroy_audio_objects_callback, work, NULL))
+        {
+            memset(objects, 0, sizeof(*objects));
+            return;
+        }
+        if (work->module)
+            FreeLibrary(work->module);
+        free(work);
+    }
+    audio_renderer_destroy_audio_objects(renderer, objects);
+    if (event)
+        CloseHandle(event);
 }
 
