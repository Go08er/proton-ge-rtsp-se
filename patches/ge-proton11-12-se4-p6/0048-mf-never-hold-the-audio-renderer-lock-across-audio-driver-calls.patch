+static void audio_renderer_destroy_audio_objects(struct audio_renderer *renderer, struct audio_objects *objects)
+{
+    HRESULT hr;
+    DWORD start;
+
+    if (objects->client)
+    {
+        start = GetTickCount();
+        hr = IAudioClient_Stop(objects->client);
+        audio_renderer_call_done(renderer, "Stop", start, hr);
+        start = GetTickCount();
+        hr = IAudioClient_Reset(objects->client);
