+/* Called with renderer->cs and transition_cs held. Drops renderer->cs for the driver calls. Reset is skipped if
+ * Stop failed. Returns FALSE if the audio client was replaced meanwhile, in which case the renderer state must not
+ * be updated from the results. */
+static BOOL audio_renderer_stop_reset(struct audio_renderer *renderer, BOOL stop, BOOL reset, HRESULT *stop_hr,
+        HRESULT *reset_hr)
+{
+    unsigned int generation = renderer->client_generation;
+    IAudioClient *client = renderer->audio_client;
+    DWORD start;
+
+    *stop_hr = *reset_hr = S_OK;
+    IAudioClient_AddRef(client);
+    renderer->flags |= SAR_CLIENT_BUSY;
+    LeaveCriticalSection(&renderer->cs);
+    if (stop)
+    {
+        start = GetTickCount();
+        *stop_hr = IAudioClient_Stop(client);
+        audio_renderer_call_done(renderer, "Stop", start, *stop_hr);
+    }
+    if (SUCCEEDED(*stop_hr) && reset)
+    {
+        start = GetTickCount();
+        *reset_hr = IAudioClient_Reset(client);
+        audio_renderer_call_done(renderer, "Reset", start, *reset_hr);
+    }
+    IAudioClient_Release(client);
+    EnterCriticalSection(&renderer->cs);
+    renderer->flags &= ~SAR_CLIENT_BUSY;
+
+    return generation == renderer->client_generation;
+}
