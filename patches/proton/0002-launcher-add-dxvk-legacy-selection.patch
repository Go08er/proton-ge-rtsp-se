             use_dxvk_d3d8 = "dxvkd3d8" in g_session.compat_config
+            # The DLL copies below run on every launch, so a flag flip swaps
+            # the DXVK set without touching prefix_info or forcing an update.
+            dxvk_dir, dxvk_legacy_active = dxvk_variant_dir(g_proton.lib_dir,
