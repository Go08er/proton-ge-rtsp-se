+# Dual DXVK: the legacy DXVK build ships beside the primary one in
+# lib/wine/dxvk-legacy.  AppIDs listed here default to it; every other AppID
+# keeps the primary DXVK unless PROTON_DXVK_LEGACY or the dxvklegacy token asks.
+DXVK_LEGACY_DEFAULT_APPIDS = ("438100",)  # VRChat
+
+def dxvk_variant_dir(lib_dir, want_legacy):
+    """Return (directory below lib_dir, legacy active) for the DXVK DLL set."""
+    if want_legacy and file_exists(lib_dir + "wine/dxvk-legacy", follow_symlinks=True):
+        return "wine/dxvk-legacy", True
+    return "wine/dxvk", False
+
