+    def select_dxvk_variant(self):
+        """Resolve the DXVK variant, highest priority first: the environment
+        (launch options or user_settings.py), the dxvklegacy / nodxvklegacy
+        tokens, the per-AppID default, then the primary DXVK.  Leaves the
+        decision in compat_config as "dxvklegacy" and returns the reason."""
+        reason = "none"
+        if "PROTON_DXVK_LEGACY" in self.env:
+            reason = "env"
+        elif "nodxvklegacy" in self.compat_config or "dxvklegacy" in self.compat_config:
+            reason = "token"
+            if "nodxvklegacy" in self.compat_config:
+                # Both tokens: fail safe to the primary DXVK.
+                self.compat_config.discard("dxvklegacy")
+        else:
+            appid = self.env.get("SteamGameId", "")
+            if not appid:
+                umu_id = self.env.get("UMU_ID", "")
+                if umu_id.startswith("umu-") and umu_id[4:].isdigit():
+                    appid = umu_id[4:]
+            if appid in DXVK_LEGACY_DEFAULT_APPIDS:
+                self.compat_config.add("dxvklegacy")
+                reason = "appid-default"
+        self.check_environment("PROTON_DXVK_LEGACY", "dxvklegacy")
+        return reason
+
