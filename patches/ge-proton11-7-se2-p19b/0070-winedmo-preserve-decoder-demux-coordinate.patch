From: RTSP-on-GE11 contributors <noreply@invalid>
Subject: [PATCH] winedmo: preserve decoded audio coordinates instead of zeroing the first output

The decoder must not independently remove the first decoded audio timestamp.
Exact-content ALAC observations on immutable P19a show that doing so changes
the native audio/video offset on SourceReader, Session and MediaEngine routes.
SourceReader's separately reviewed common-origin handling belongs at that
client boundary, not inside the shared decoder.

Remove only audio_output_pts_adjust and its now-dead initialization/reset.
Keep the existing negative-input adjustment, frame-relative packet anchoring,
missing-PTS synthesis, AAC splitting, accumulation and chunk timestamps.
Flush still preserves the negative-input mapping and clears decoded state;
subsequent output follows subsequent input timestamps without a new origin.

This is a separate component delta against retained P19a, not an active-series
change. The license of the modified Wine source file applies to this patch.

diff --git a/dlls/winedmo/unix_transform.c b/dlls/winedmo/unix_transform.c
--- a/dlls/winedmo/unix_transform.c
+++ b/dlls/winedmo/unix_transform.c
@@ -76,7 +76,6 @@ struct unix_transform
     INT64               audio_base_pts;  /* absolute pts of first byte in audio_buf */
     INT64               last_input_pts;  /* pts of the most recently pushed input packet (100ns units), INT64_MIN if unknown */
     INT64               audio_pts_offset;
-    INT64               audio_output_pts_adjust;
     INT64               cumulative_samples; /* PCM samples emitted since last pts anchor; used to synthesise pts for codecs
                                              * (e.g. MS-ADPCM) that only stamp the first decoded frame in a packet */
     enum AVSampleFormat out_sample_fmt;
@@ -752,7 +751,6 @@ NTSTATUS transform_create( void *arg )
 
     if (!(t = calloc( 1, sizeof(*t) ))) return STATUS_NO_MEMORY;
     t->last_input_pts = INT64_MIN;
-    t->audio_output_pts_adjust = INT64_MIN;
     t->last_video_pts = INT64_MIN;
     t->last_video_duration = INT64_MIN;
     t->last_video_input_duration = INT64_MIN;
@@ -1141,7 +1139,6 @@ NTSTATUS transform_push_data( void *arg )
     if (t->is_audio && (params->flags & WINEDMO_SAMPLE_FLAG_DISCONTINUITY))
     {
         t->audio_pts_offset = 0;
-        t->audio_output_pts_adjust = INT64_MIN;
         t->audio_started = false;
     }
 
@@ -1566,16 +1563,6 @@ NTSTATUS transform_get_output( void *arg )
          * (legacy PROVIDES_SAMPLES query) get STATUS_BUFFER_TOO_SMALL with the full
          * size; all other callers receive up to capacity bytes with INCOMPLETE set when
          * more data remains. */
-        if (!t->audio_started && t->audio_output_pts_adjust == INT64_MIN
-                && base_pts != INT64_MIN
-                && (t->avctx->codec_id != AV_CODEC_ID_AAC || !t->split_aac_output))
-            t->audio_output_pts_adjust = base_pts;
-        if (base_pts != INT64_MIN && t->audio_output_pts_adjust != INT64_MIN)
-        {
-            base_pts -= t->audio_output_pts_adjust;
-            params->pts = base_pts;
-        }
-
         params->flags |= WINEDMO_SAMPLE_FLAG_SYNC_POINT;
         if (!t->audio_started)
             params->flags |= WINEDMO_SAMPLE_FLAG_DISCONTINUITY;
@@ -1723,9 +1710,9 @@ NTSTATUS transform_flush( void *arg )
     t->video_trace_count  = 0;
     t->audio_base_pts     = 0;
     t->last_input_pts     = INT64_MIN;
-    /* Keep the established input-to-output timestamp mapping across a decoder
-     * flush. Discarding queued decode state does not start a new presentation
-     * timeline; explicit input-discontinuity handling remains separate. */
+    /* Keep the negative-input timestamp adjustment across a decoder flush.
+     * Output follows the new input times, without establishing a new origin;
+     * explicit input-discontinuity handling remains separate. */
     t->audio_started      = false;
     t->last_video_pts     = INT64_MIN;
     t->last_video_duration = INT64_MIN;
