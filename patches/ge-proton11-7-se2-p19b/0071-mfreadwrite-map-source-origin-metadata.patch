+static BOOL source_reader_add_timestamp(LONGLONG timestamp, LONGLONG offset, LONGLONG *result)
+{
+    /* Do not turn an unknown timestamp into a plausible value or saturate
+     * negative preroll.  A representational overflow is an invalid timestamp. */
+    if (timestamp == INT64_MIN || timestamp == INT64_MAX
+            || (offset > 0 && timestamp > INT64_MAX - offset)
+            || (offset < 0 && timestamp < INT64_MIN - offset))
+        return FALSE;
+    *result = timestamp + offset;
+    return *result != INT64_MIN && *result != INT64_MAX;
+}
