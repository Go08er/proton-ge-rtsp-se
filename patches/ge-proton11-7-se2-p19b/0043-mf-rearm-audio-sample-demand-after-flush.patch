Subject: [PATCH] Context-only refresh without qualification diagnostics

Original: patches/proposed/0043-mf-rearm-audio-sample-demand-after-flush.patch
Added/removed line multiset is identical; only context/line positions differ.
---
--- a/dlls/mf/sar.c
+++ b/dlls/mf/sar.c
@@ -39,6 +39,7 @@
     SAR_REPORT_SEEK_TIME = 0x10,
     SAR_ADDING_SILENCE = 0x20,
     SAR_AUDIO_START_PENDING = 0x40,
+    SAR_END_OF_SEGMENT_RECEIVED = 0x80,
 };
 
 enum queued_object_type
@@ -1611,7 +1612,7 @@
     {
         if (renderer->clock_state == MFCLOCK_STATE_RUNNING)
             hr = stream_queue_sample(renderer, sample);
-        renderer->flags &= ~SAR_SAMPLE_REQUESTED;
+        renderer->flags &= ~(SAR_SAMPLE_REQUESTED | SAR_END_OF_SEGMENT_RECEIVED);
 
         if (renderer->queued_frames < renderer->max_frames && renderer->clock_state == MFCLOCK_STATE_RUNNING)
         {
@@ -1661,7 +1662,11 @@
     if (renderer->flags & SAR_SHUT_DOWN)
         hr = MF_E_STREAMSINK_REMOVED;
     else
+    {
         hr = stream_place_marker(renderer, marker_type, context_value);
+        if (SUCCEEDED(hr) && marker_type == MFSTREAMSINK_MARKER_ENDOFSEGMENT)
+            renderer->flags |= SAR_END_OF_SEGMENT_RECEIVED;
+    }
 
     LeaveCriticalSection(&renderer->cs);
 
@@ -1691,6 +1696,10 @@
             }
             release_pending_object(obj);
         }
+        /* A marker can fulfill the last request without ProcessSample.
+         * Rearm that demand once; preserve ordinary outstanding requests. */
+        if (renderer->flags & SAR_END_OF_SEGMENT_RECEIVED)
+            renderer->flags &= ~(SAR_SAMPLE_REQUESTED | SAR_END_OF_SEGMENT_RECEIVED);
     }
     renderer->queued_frames = 0;
 
