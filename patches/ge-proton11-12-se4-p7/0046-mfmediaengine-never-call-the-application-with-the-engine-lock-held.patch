+    MEDIA_ENGINE_DIAG_SLOW_NOTIFY_ERR,
+    MEDIA_ENGINE_DIAG_LOCK_WAIT_WARN,
+    MEDIA_ENGINE_DIAG_LOCK_WAIT_ERR,
+    MEDIA_ENGINE_DIAG_LOCK_HOLD_WARN,
+    MEDIA_ENGINE_DIAG_LOCK_HOLD_ERR,
+    MEDIA_ENGINE_DIAG_COUNT,
+};
+
 struct media_engine
 {
     IMFMediaEngineEx IMFMediaEngineEx_iface;
@@ -241,8 +262,402 @@
         } d3d11;
     } video_frame;
     CRITICAL_SECTION cs;
+    /* Lock bookkeeping, written by the owner of cs; read without it only for diagnostics. */
+    unsigned int lock_depth;
+    BOOL lock_internal;     /* the outermost holder is a work-queue callback, which may wait to deliver */
+    const char *volatile lock_site;
+    volatile DWORD lock_tid;
+    volatile LONGLONG delivery_since;   /* when the callback now running started, 0 if none; interlocked */
+    volatile LONGLONG lock_since;   /* read with an interlocked operation, 32-bit targets tear 64-bit reads */
+    /* Notifications raised but not yet delivered, see media_engine_unlock(). Protected by cs. */
+    struct
+    {
+        struct media_engine_event *events;
+        size_t count, capacity;
+        LONG closed;
+        LONG guard_reported;
+        LONG handed_off;    /* entries marked handed off, read without engine->cs */
+    } outbox;
+    /* Held while the application is called; recursive, never acquired with cs held. */
+    CRITICAL_SECTION delivery_cs;
+    ULONGLONG diag_time[MEDIA_ENGINE_DIAG_COUNT];
 };
 
+/* Locking and notification rules.
+ *
+ * The engine never calls application code (IMFMediaEngineNotify and
+ * IMFMediaEngineExtension) with engine->cs held. An application callback may
+ * run for a long time, or wait for a thread that is itself waiting in an
+ * engine call, and with the lock held that stops every caller of the engine,
+ * the per-frame calls included.
+ *
+ * Every notification therefore goes through media_engine_notify(), which only
+ * appends it, tagged with the raising thread, to the per-engine outbox. The
+ * thread that releases engine->cs at its outermost level delivers its own
+ * notifications, in order, after leaving it and before the call that raised
+ * them returns, as before: each notification is delivered by the thread that
+ * raised it.
+ *
+ * The application still never sees two notifications of one engine at once:
+ * delivery holds delivery_cs, a recursive lock that is never acquired while
+ * engine->cs is held (the order is delivery_cs, then engine->cs). Work-queue
+ * callbacks (session events, sink events, load handler) wait for it, holding
+ * no engine lock, as they waited for engine->cs before. An application-facing
+ * call does not wait for another thread's callback (beyond a short grace, see
+ * media_engine_try_delivery()): when delivery_cs stays taken it marks its
+ * notifications handed off and returns, and the holder delivers
+ * handed-off notifications, in order, before it releases (and looks again
+ * after releasing, so none is left behind). A call made from inside a
+ * callback takes delivery_cs recursively and delivers the notifications it
+ * raises before it returns.
+ *
+ * A site whose later logic depends on the application having seen the
+ * notification calls media_engine_flush_notifications() and then revalidates
+ * its state, because the lock is dropped there.
+ *
+ * Every acquisition goes through media_engine_lock() or
+ * media_engine_lock_wq(), which also report long waits together with the
+ * site that held the lock. */
+
+#define MEDIA_ENGINE_SLOW_NOTIFY_WARN_MS 100
+#define MEDIA_ENGINE_SLOW_NOTIFY_ERR_MS  1000
+#define MEDIA_ENGINE_LOCK_WAIT_WARN_MS  50
+#define MEDIA_ENGINE_LOCK_WAIT_ERR_MS   1000
+#define MEDIA_ENGINE_LOCK_HOLD_WARN_MS  100
+#define MEDIA_ENGINE_LOCK_HOLD_ERR_MS   1000
+#define MEDIA_ENGINE_DIAG_INTERVAL_MS   1000
+#define MEDIA_ENGINE_DELIVERY_GRACE_MS  10
+
+/* At most one line per engine and kind per second. */
+static BOOL media_engine_diag_allowed(struct media_engine *engine, enum media_engine_diag kind)
+{
+    ULONGLONG now = GetTickCount64();
+
+    if (engine->diag_time[kind] && now - engine->diag_time[kind] < MEDIA_ENGINE_DIAG_INTERVAL_MS)
+        return FALSE;
+    engine->diag_time[kind] = now;
+    return TRUE;
+}
+
+/* 0: nothing to report, 1: WARN, 2: ERR; the kind pairs are WARN, ERR in this order. */
+static int media_engine_diag_level(struct media_engine *engine, enum media_engine_diag warn_kind, ULONGLONG ms,
+        ULONGLONG warn_ms, ULONGLONG err_ms)
+{
+    if (ms >= err_ms)
+        return media_engine_diag_allowed(engine, warn_kind + 1) ? 2 : 0;
+    if (ms >= warn_ms)
+        return media_engine_diag_allowed(engine, warn_kind) ? 1 : 0;
+    return 0;
+}
+
+#define MEDIA_ENGINE_DIAG(level, ...) \
+    do { if ((level) == 2) ERR(__VA_ARGS__); else if ((level) == 1) WARN(__VA_ARGS__); } while (0)
+
+/* Called at the outermost release, with the lock held: how long it was held, and by which site. */
+static void media_engine_report_lock_hold(struct media_engine *engine)
+{
+    ULONGLONG held = GetTickCount64() - engine->lock_since;
+    int level = media_engine_diag_level(engine, MEDIA_ENGINE_DIAG_LOCK_HOLD_WARN, held,
+            MEDIA_ENGINE_LOCK_HOLD_WARN_MS, MEDIA_ENGINE_LOCK_HOLD_ERR_MS);
+
+    MEDIA_ENGINE_DIAG(level, "%s held the engine lock for %lu ms (thread %04lx).\n", engine->lock_site,
+            (unsigned long)held, engine->lock_tid);
+}
+
+static void media_engine_lock_common(struct media_engine *engine, const char *site, BOOL internal)
+{
+    if (!TryEnterCriticalSection(&engine->cs))
+    {
+        const char *holder = engine->lock_site;
+        DWORD holder_tid = engine->lock_tid;
+        ULONGLONG start = GetTickCount64(), since = InterlockedCompareExchange64(&engine->lock_since, 0, 0), wait;
+        int level;
+
+        EnterCriticalSection(&engine->cs);
+        wait = GetTickCount64() - start;
+        level = media_engine_diag_level(engine, MEDIA_ENGINE_DIAG_LOCK_WAIT_WARN, wait,
+                MEDIA_ENGINE_LOCK_WAIT_WARN_MS, MEDIA_ENGINE_LOCK_WAIT_ERR_MS);
+        MEDIA_ENGINE_DIAG(level, "%s waited %lu ms for the engine lock, held by %s (thread %04lx, held %lu ms when the wait began).\n",
+                site, (unsigned long)wait, holder ? holder : "(unknown)", holder_tid,
+                (unsigned long)(since && start > since ? start - since : 0));
+    }
+
+    if (!engine->lock_depth++)
+    {
+        engine->lock_tid = GetCurrentThreadId();
+        InterlockedCompareExchange64(&engine->lock_since, GetTickCount64(), engine->lock_since); /* only the owner writes */
+        engine->lock_site = site;
+        engine->lock_internal = internal;
+    }
+}
+
+/* For application-facing methods. */
+static void media_engine_lock(struct media_engine *engine, const char *site)
+{
+    media_engine_lock_common(engine, site, FALSE);
+}
+
+/* For work-queue callbacks, which may wait for another thread's callback to finish. */
+static void media_engine_lock_wq(struct media_engine *engine, const char *site)
+{
+    media_engine_lock_common(engine, site, TRUE);
+}
+
+/* Regression guard: nothing may call the application with the lock held. */
+static void media_engine_check_app_call(struct media_engine *engine, const char *what)
+{
+    if (RtlIsCriticalSectionLockedByThread(&engine->cs) && !InterlockedExchange(&engine->outbox.guard_reported, 1))
+        ERR("%s is about to be called with the engine lock held.\n", what);
+}
+
+static void media_engine_deliver_event(struct media_engine *engine, const struct media_engine_event *event)
+{
+    ULONGLONG start, elapsed;
+    LONGLONG outer_since;
+    HRESULT hr;
+    int level;
+
+    media_engine_check_app_call(engine, "A notification");
+
+    start = GetTickCount64();
+    /* The holder of delivery_cs is the only writer; a nested callback restores the outer one's start. */
+    outer_since = InterlockedCompareExchange64(&engine->delivery_since, 0, 0);
+    InterlockedCompareExchange64(&engine->delivery_since, start, outer_since);
+    hr = IMFMediaEngineNotify_EventNotify(engine->callback, event->event, event->param1, event->param2);
+    elapsed = GetTickCount64() - start;
+    InterlockedCompareExchange64(&engine->delivery_since, outer_since, start);
+
+    TRACE("Notification %u, param1 %s, param2 %#lx: callback hr %#lx, %lu ms.\n", event->event,
+            wine_dbgstr_longlong(event->param1), event->param2, hr, (unsigned long)elapsed);
+
+    level = media_engine_diag_level(engine, MEDIA_ENGINE_DIAG_SLOW_NOTIFY_WARN, elapsed,
+            MEDIA_ENGINE_SLOW_NOTIFY_WARN_MS, MEDIA_ENGINE_SLOW_NOTIFY_ERR_MS);
+    MEDIA_ENGINE_DIAG(level, "Notification %u took %lu ms in the application callback (thread %04lx).\n",
+            event->event, (unsigned long)elapsed, GetCurrentThreadId());
+}
+
+/* An application call does not wait for another thread's callback, with one exception: an application
+ * often signals from a handler and the signalled thread calls the engine at once, while the handler is
+ * still returning. A call therefore waits for a callback that started less than MEDIA_ENGINE_DELIVERY_GRACE_MS
+ * ago, until that time is up, which keeps the notification of that call on the calling thread. A callback that
+ * has run longer gets the notification handed off at once, so a slow handler costs the caller nothing. */
+static BOOL media_engine_try_delivery(struct media_engine *engine)
+{
+    ULONGLONG now = GetTickCount64(), since, deadline = now + MEDIA_ENGINE_DELIVERY_GRACE_MS;
+
+    while (!TryEnterCriticalSection(&engine->delivery_cs))
+    {
+        since = InterlockedCompareExchange64(&engine->delivery_since, 0, 0);
+        if (since && since + MEDIA_ENGINE_DELIVERY_GRACE_MS < deadline)
+            deadline = since + MEDIA_ENGINE_DELIVERY_GRACE_MS;
+        if (GetTickCount64() >= deadline)
+            return FALSE;
+        Sleep(1);
+    }
+    return TRUE;
+}
+
+/* Takes the notifications this thread raised, and those handed off, out of the outbox, in order.
+ * Only this thread's own entries when own_only: a work-queue thread that takes before it waits for the delivery
+ * lock must leave handed-off entries in the outbox, or a later one could overtake an earlier one of the same
+ * thread. Called with engine->cs held. Returns NULL when there are none, or when memory ran out (*failed): the
+ * entries then stay for the next deliverer, or for Shutdown. */
+static struct media_engine_event *media_engine_take_events(struct media_engine *engine, DWORD tid, BOOL own_only,
+        size_t *count, BOOL *failed)
+{
+    struct media_engine_event *batch, *events = engine->outbox.events;
+    size_t i, n = 0, kept = 0;
+
+    *failed = FALSE;
+    for (i = 0; i < engine->outbox.count; ++i)
+        if ((events[i].thread_id == tid && !events[i].handed_off) || (!own_only && events[i].handed_off))
+            ++n;
+    *count = n;
+    if (!n)
+        return NULL;
+    if (!(batch = malloc(n * sizeof(*batch))))
+    {
+        *failed = TRUE;
+        return NULL;
+    }
+
+    for (i = 0, n = 0; i < engine->outbox.count; ++i)
+    {
+        if ((events[i].thread_id == tid && !events[i].handed_off) || (!own_only && events[i].handed_off))
+        {
+            if (events[i].handed_off)
+                InterlockedDecrement(&engine->outbox.handed_off);
+            batch[n++] = events[i];
+        }
+        else
+            events[kept++] = events[i];
+    }
+    engine->outbox.count = kept;
+    return batch;
+}
+
+/* Releases the lock, and at the outermost level delivers this thread's notifications. */
+static void media_engine_unlock(struct media_engine *engine)
+{
+    DWORD tid = GetCurrentThreadId();
+    struct media_engine_event *batch = NULL;
+    BOOL internal, mine = FALSE, failed = FALSE;
+    size_t count = 0, i;
+
+    if (--engine->lock_depth)
+    {
+        LeaveCriticalSection(&engine->cs);
+        return;
+    }
+    media_engine_report_lock_hold(engine);
+    engine->lock_site = NULL;
+    internal = engine->lock_internal;
+
+    /* Entries handed off earlier are the holder's to deliver, they must not cost this call a wait again. */
+    for (i = 0; i < engine->outbox.count; ++i)
+        if (engine->outbox.events[i].thread_id == tid && !engine->outbox.events[i].handed_off)
+            mine = TRUE;
+    if (!mine)
+    {
+        LeaveCriticalSection(&engine->cs);
+        return;
+    }
+
+    if (internal)
+    {
+        /* A work-queue thread takes its entries while it still holds the lock, so that it is back at its queue
+         * as soon as it has delivered them, then waits for the delivery lock. */
+        batch = media_engine_take_events(engine, tid, TRUE, &count, &failed);
+        LeaveCriticalSection(&engine->cs);
+        if (!batch)
+            return;
+        EnterCriticalSection(&engine->delivery_cs);
+    }
+    else
+    {
+        LeaveCriticalSection(&engine->cs);
+        if (!media_engine_try_delivery(engine))
+        {
+            /* Another thread is still in a callback: hand over, then try once more, without waiting, as it
+             * may have just left. Whoever holds the lock looks for handed-off entries before leaving it. */
+            EnterCriticalSection(&engine->cs);
+            for (i = 0; i < engine->outbox.count; ++i)
+                if (engine->outbox.events[i].thread_id == tid && !engine->outbox.events[i].handed_off)
+                {
+                    engine->outbox.events[i].handed_off = TRUE;
+                    InterlockedIncrement(&engine->outbox.handed_off);
+                }
+            LeaveCriticalSection(&engine->cs);
+            if (!TryEnterCriticalSection(&engine->delivery_cs))
+                return;
+        }
+    }
+
+    IMFMediaEngineEx_AddRef(&engine->IMFMediaEngineEx_iface);
+    IMFMediaEngineNotify_AddRef(engine->callback);
+
+    do
+    {
+        for (;;)
+        {
+            if (!batch)
+            {
+                EnterCriticalSection(&engine->cs);
+                batch = media_engine_take_events(engine, tid, FALSE, &count, &failed);
+                LeaveCriticalSection(&engine->cs);
+                if (!batch)
+                    break;
+            }
+
+            for (i = 0; i < count; ++i)
+            {
+                /* Shutdown drops what has not started. */
+                if (InterlockedCompareExchange(&engine->outbox.closed, 0, 0))
+                    break;
+                media_engine_deliver_event(engine, &batch[i]);
+            }
+            free(batch);
+            batch = NULL;
+            if (!InterlockedCompareExchange(&engine->outbox.handed_off, 0, 0))
+                break;
+        }
+        LeaveCriticalSection(&engine->delivery_cs);
+        /* A thread that found the lock taken marked its entries before trying again: if one did, and the
+         * lock is free now, deliver them (otherwise whoever holds it does). */
+    } while (!failed && InterlockedCompareExchange(&engine->outbox.handed_off, 0, 0)
+            && TryEnterCriticalSection(&engine->delivery_cs));
+
+    IMFMediaEngineNotify_Release(engine->callback);
+    IMFMediaEngineEx_Release(&engine->IMFMediaEngineEx_iface);
+}
+
+/* Drops the lock for a call that must not run with it held, at the outermost level only (when it is held more
+ * than once it cannot be dropped, and the caller goes on with it held). Returns the state for retake. */
+static BOOL media_engine_drop_lock(struct media_engine *engine, BOOL *internal)
+{
+    if (engine->lock_depth != 1)
+        return FALSE;
+    *internal = engine->lock_internal;
+    media_engine_unlock(engine);
+    return TRUE;
+}
+
+static void media_engine_retake_lock(struct media_engine *engine, const char *site, BOOL internal)
+{
+    media_engine_lock_common(engine, site, internal);
+}
+
+/* Raises a notification; delivered when the lock is released. Called with the lock held. */
+static void media_engine_notify(struct media_engine *engine, MF_MEDIA_ENGINE_EVENT event, DWORD_PTR param1,
+        DWORD param2)
+{
+    struct media_engine_event *entry;
+
+    if (engine->outbox.closed)
+        return;
+
+    if (!mf_array_reserve((void **)&engine->outbox.events, &engine->outbox.capacity, engine->outbox.count + 1,
+            sizeof(*engine->outbox.events)))
+    {
+        ERR("Failed to queue notification %u.\n", event);
+        return;
+    }
+
+    entry = &engine->outbox.events[engine->outbox.count++];
+    entry->event = event;
+    entry->param1 = param1;
+    entry->param2 = param2;
+    entry->thread_id = GetCurrentThreadId();
+    entry->handed_off = FALSE;
+}
+
+/* Delivers what has been raised so far, with the lock dropped, and takes the lock again. The caller must
+ * revalidate whatever it read before: the application can call back into the engine from its handlers.
+ * Does nothing when the lock is held more than once, as it cannot be dropped then; the events are then
+ * delivered when the outermost holder leaves. */
+static void media_engine_flush_notifications(struct media_engine *engine, const char *site)
+{
+    BOOL internal;
+
+    if (media_engine_drop_lock(engine, &internal))
+        media_engine_retake_lock(engine, site, internal);
+}
+
+/* Shutdown: drops what has not been delivered, and nothing more is queued. Called with the lock held. */
+static void media_engine_close_notifications(struct media_engine *engine)
+{
+    InterlockedExchange(&engine->outbox.closed, 1);
+    InterlockedExchange(&engine->outbox.handed_off, 0);
+    free(engine->outbox.events);
+    engine->outbox.events = NULL;
+    engine->outbox.count = engine->outbox.capacity = 0;
+}
+
+static BOOL media_engine_source_is_current(struct media_engine *engine, UINT64 generation)
+{
+    return !(engine->flags & FLAGS_ENGINE_SHUT_DOWN) && generation == engine->source_generation;
+}
