Subject: [PATCH] mf: report terminal direct-stream filter failures as decode errors

A real corrupted-NAL fixture plays normally at first on SE2-P1, then its
H.264 bitstream filter rejects a packet. Wine maps that error to ordinary EOF:
MediaEngine sends ENDED with no ERROR. This is not a successful end of media.

Return STATUS_DATA_ERROR for terminal filter failures on direct inputs and
carry MF_E_INVALID_STREAM_DATA through the existing current-source terminal
error path. Preserve network error classification, cancellation/epoch guards,
once-only forwarding, pending-command completion, and manual reopen. Filter
allocation failures retain an explicit out-of-memory status; the producer
must not spin retrying that allocation once it has failed.

Local custom-bytestream filter behavior and real EOF draining are unchanged.
No decoder reset, reconnect or retry is added. This fixes error attribution,
not the cause of the separate live HEVC repeated-seek failure.
---
diff --git a/dlls/winedmo/unix_demuxer.c b/dlls/winedmo/unix_demuxer.c
--- a/dlls/winedmo/unix_demuxer.c
+++ b/dlls/winedmo/unix_demuxer.c
@@ -1347,7 +1347,8 @@
 
     /* Preserve the legacy local-bytestream behavior while keeping terminal
      * failures on direct HTTP, HLS, and RTSP inputs distinct from clean EOF. */
-    if (!demuxer->direct_url || !input_error) return STATUS_END_OF_FILE;
+    if (!demuxer->direct_url) return STATUS_END_OF_FILE;
+    if (!input_error) return ret == AVERROR(ENOMEM) ? STATUS_NO_MEMORY : STATUS_DATA_ERROR;
     if (__atomic_load_n( &demuxer->cancelled, __ATOMIC_ACQUIRE )) return STATUS_CANCELLED;
     if (ret == AVERROR_EXIT || ret == AVERROR(ETIMEDOUT)) return STATUS_IO_TIMEOUT;
     return STATUS_CONNECTION_DISCONNECTED;
diff --git a/dlls/winedmo/media_source.c b/dlls/winedmo/media_source.c
--- a/dlls/winedmo/media_source.c
+++ b/dlls/winedmo/media_source.c
@@ -485,6 +485,10 @@
         return MF_E_NET_TIMEOUT;
     if (status == STATUS_CONNECTION_DISCONNECTED)
         return MF_E_NET_READ;
+    if (status == STATUS_DATA_ERROR)
+        return MF_E_INVALID_STREAM_DATA;
+    if (status == STATUS_NO_MEMORY)
+        return E_OUTOFMEMORY;
     return HRESULT_FROM_NT(status);
 }
 
@@ -1857,7 +1861,7 @@
                 source->drain_diag_max_read_ms = read_elapsed;
         }
 
-        /* Claim a terminal network error while this lock still excludes a
+        /* Claim a terminal demux error while this lock still excludes a
          * seek. A seek which began before this claim changes the transition
          * epoch; demux_error_cs separately orders the claim against the final
          * Started/Seeked event commit without covering a blocking read. */
@@ -1869,7 +1873,8 @@
             continue;
         }
         if (status == STATUS_CANCELLED || status == STATUS_IO_TIMEOUT
-                || status == STATUS_CONNECTION_DISCONNECTED)
+                || status == STATUS_CONNECTION_DISCONNECTED || status == STATUS_DATA_ERROR
+                || status == STATUS_NO_MEMORY)
         {
             HRESULT error = media_source_error_from_demux_status(status);
 
diff --git a/dlls/mf/session.c b/dlls/mf/session.c
--- a/dlls/mf/session.c
+++ b/dlls/mf/session.c
@@ -4893,7 +4893,8 @@
                 if (hr == MF_E_SHUTDOWN)
                     session_handle_source_shutdown(session);
                 else if (hr == MF_E_OPERATION_CANCELLED || hr == MF_E_NET_TIMEOUT
-                        || hr == MF_E_NET_READ || hr == MF_E_INVALID_POSITION)
+                        || hr == MF_E_NET_READ || hr == MF_E_INVALID_POSITION
+                        || hr == MF_E_INVALID_STREAM_DATA || hr == E_OUTOFMEMORY)
                 {
                     if (!(session_source->flags & SOURCE_FLAG_TERMINAL_ERROR_FORWARDED))
                     {
diff --git a/dlls/mfmediaengine/main.c b/dlls/mfmediaengine/main.c
--- a/dlls/mfmediaengine/main.c
+++ b/dlls/mfmediaengine/main.c
@@ -1212,7 +1212,8 @@
 
             if (FAILED(IMFMediaEvent_GetStatus(event, &error)) ||
                     (error != MF_E_OPERATION_CANCELLED && error != MF_E_NET_TIMEOUT
-                    && error != MF_E_NET_READ && error != MF_E_INVALID_POSITION) ||
+                    && error != MF_E_NET_READ && error != MF_E_INVALID_POSITION
+                    && error != MF_E_INVALID_STREAM_DATA && error != E_OUTOFMEMORY) ||
                     FAILED(IMFMediaEvent_GetValue(event, &source)) ||
                     source.vt != VT_UNKNOWN || !source.punkVal)
             {
@@ -1222,7 +1223,8 @@
 
             if (error == MF_E_OPERATION_CANCELLED)
                 error_code = MF_MEDIA_ENGINE_ERR_ABORTED;
-            else if (error == MF_E_INVALID_POSITION)
+            else if (error == MF_E_INVALID_POSITION || error == MF_E_INVALID_STREAM_DATA
+                    || error == E_OUTOFMEMORY)
                 error_code = MF_MEDIA_ENGINE_ERR_DECODE;
             else
                 error_code = MF_MEDIA_ENGINE_ERR_NETWORK;
