+            && SUCCEEDED(IMFMediaType_GetBlobSize(type, &MF_MT_MPEG_SEQUENCE_HEADER, &user_data_size)))
+        data_key = &MF_MT_MPEG_SEQUENCE_HEADER;
+    else if (FAILED(IMFMediaType_GetBlobSize(type, data_key, &user_data_size)))
+        user_data_size = 0;
+    if (user_data_size > UINT32_MAX - size)
+        return E_INVALIDARG;
+    size += user_data_size;
 
     if (!(fmt = calloc(1, size)))
         return E_OUTOFMEMORY;
