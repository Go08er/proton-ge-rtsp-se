+/* Audio drivers such as winepulse advance the IAudioClock position one device
+ * period at a time, where Windows reports a device-interpolated position. Time
+ * mapped directly from it moves in period-sized steps, so frames due at a finer
+ * cadence (60 fps against a 10 ms period) are shown unevenly. The reported time
+ * lags the true one by less than a period, and by almost nothing just after a
+ * step, so the largest (time - counter) offset seen tracks the true offset.
+ * Report the counter plus that offset: smooth, monotonic, and never more than
+ * one period ahead of the reported position. The estimate decays by 1 ms per
+ * second, so clock drift and backward timeline steps pull it back. */
+static LONGLONG audio_renderer_smooth_time(struct audio_renderer *renderer, LONGLONG time, LONGLONG counter)
+{
+    LONGLONG offset = time - counter, decayed;
+
+    if (renderer->clock_state != MFCLOCK_STATE_RUNNING || renderer->rate == 0.0f
+            || (renderer->flags & SAR_AUDIO_START_PENDING))
+    {
+        renderer->smooth_offset_valid = FALSE;
+        if (renderer->smooth_time_valid && time < renderer->smooth_time)
+            time = renderer->smooth_time;
+        return time;
+    }
+
+    if (!renderer->smooth_offset_valid)
+    {
+        renderer->smooth_offset = offset;
+        renderer->smooth_offset_valid = TRUE;
+    }
+    else
+    {
+        decayed = renderer->smooth_offset;
+        if (counter > renderer->smooth_counter)
+            decayed -= (counter - renderer->smooth_counter) / 1000;
+        renderer->smooth_offset = max(offset, decayed);
+        renderer->smooth_offset = min(renderer->smooth_offset, offset + renderer->device_period);
+    }
+    renderer->smooth_counter = counter;
+
+    time = counter + renderer->smooth_offset;
+    if (renderer->smooth_time_valid && time < renderer->smooth_time)
+        time = renderer->smooth_time;
+    renderer->smooth_time = time;
+    renderer->smooth_time_valid = TRUE;
+    return time;
+}
+
 static HRESULT audio_renderer_get_correlated_time(struct audio_renderer *renderer, LONGLONG *clock_time,
         MFTIME *system_time)
 {
@@ -1277,6 +1339,8 @@
         else
             renderer->flags &= ~SAR_REPORT_SEEK_TIME;
     }
+    if (!(renderer->flags & SAR_REPORT_SEEK_TIME))
+        time = audio_renderer_smooth_time(renderer, time, counter);
 
     if (clock_time)
         *clock_time = time;
@@ -1718,6 +1782,7 @@
